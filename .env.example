# Vorlage für die Einstellungen auf dem Server.
# deploy.sh kopiert sie beim ersten Start nach .env und füllt die Passwörter mit Zufallswerten.
# .env enthält Passwörter und wird nie eingecheckt.

# Domain der Website, muss per DNS auf den Server zeigen (z. B. torben-photography.de)
DOMAIN=example.com

# Fertiges Image einer Release-Version statt auf dem Server zu bauen, z. B.
# ghcr.io/torben-01/torben-photography:1.0.0 (vorher einmalig "docker login ghcr.io", siehe README).
# Leer lassen, um aus dem Quellcode zu bauen.
APP_IMAGE=

# Datenbank (nur intern zwischen App und MySQL erreichbar)
DB_USERNAME=photography
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Zugang zur Verwaltung unter https://<DOMAIN>/admin/anfragen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# E-Mail-Benachrichtigung bei neuen Anfragen (leer lassen = nur Log-Eintrag)
NOTIFICATION_RECIPIENT=
NOTIFICATION_SENDER=
NOTIFICATION_CONFIRM_CUSTOMER=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
